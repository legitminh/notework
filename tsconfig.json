{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "src/service-worker"
  ]
}
