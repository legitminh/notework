{
  "name": "notework-native",
  "version": "0.1.0",
  "private": true,
  "description": "Native desktop (Electron) and iOS (Capacitor) shells for the Notework web build.",
  "homepage": "https://github.com/legitminh/notework",
  "main": "electron/main.cjs",
  "author": "legitminh",
  "scripts": {
    "web": "node scripts/build-web.mjs",
    "desktop": "pnpm web && electron .",
    "desktop:run": "electron .",
    "build:mac": "pnpm web && electron-builder --mac",
    "build:win": "pnpm web && electron-builder --win",
    "build:linux": "pnpm web && electron-builder --linux",
    "build:desktop": "pnpm web && electron-builder",
    "ios:sync": "pnpm web && cap sync ios",
    "ios:open": "pnpm ios:sync && cap open ios",
    "build:ios": "pnpm ios:sync && node scripts/build-ios.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "packageManager": "pnpm@11.25.0"
}
