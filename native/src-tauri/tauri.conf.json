{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notework",
  "mainBinaryName": "notework",
  "version": "0.1.0",
  "identifier": "io.github.legitminh.notework",
  "build": {
    "frontendDist": "../../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir .. dev --host",
    "beforeBuildCommand": "node scripts/build-web.mjs"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "category": "Productivity",
    "shortDescription": "A local network of text documents and folders.",
    "homepage": "https://github.com/legitminh/notework",
    "publisher": "legitminh",
    "copyright": "Copyright © legitminh",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" },
    "iOS": { "minimumSystemVersion": "16.0" }
  }
}
